# Copie para `.env` na raiz e descomente o que quiser mudar.
# O `.env` é lido por hack/automations/variables.mk e NÃO é
# versionado — é a sua config local.
#
# Formato: CHAVE=valor, um por linha, `#` comenta.
# O make lê este arquivo como makefile, então:
#   - NÃO use aspas    (TOLERANCE="0.2" vira o valor  "0.2"  com aspas)
#   - NÃO use `export`
#   - NÃO deixe espaço em volta do `=`
#
# Precedência: .env perde para variável de linha de comando
# (`make build TOLERANCE=0.1`) e para EXTRA_D.
#
# Confira o resultado com:  make vars

# ------------------------------------------------------------
# Primitivos do sistema — mudar aqui muda TODA peça
# ------------------------------------------------------------
# Não existe GRID: ele é derivado (hole_d + 2×(wall+collar_w)).
# Com os defaults abaixo, grid = 8mm.

# Diâmetro do furo passante — a interface mecânica
#HOLE_D=4.0

# Parede interna mínima (4 perímetros de 0.4)
#WALL=1.6

# Degrau radial entre furo e rebaixo (1 bico de 0.4)
#COLLAR_W=0.4

# Profundidade axial do rebaixo (5 camadas de 0.2)
#COLLAR_DEPTH=1.0

# Folga de press-fit, subtraída SEMPRE do macho. É a compensação
# de impressão: furo pequeno sai subdimensionado e pino sai
# superdimensionado, então 0.2 no modelo aterrissa perto de zero
# no impresso. Se sair frouxo na sua máquina, BAIXE este valor.
#TOLERANCE=0.2

# Folga mínima entre dois machos que se aproximam dentro de uma
# célula. É o que limita pin_len — mexer aqui muda o engate.
#GAP=0.5

# ------------------------------------------------------------
# Velocidade de render
# ------------------------------------------------------------
# Facetas do círculo. 16–24 ao iterar, 48 no final.
#FN=48

# ------------------------------------------------------------
# Saída
# ------------------------------------------------------------
#IMGSIZE=800,600
#ASM_IMGSIZE=1200,900
#COLORSCHEME=Monotone
#PART_COLOR=[0.35, 0.38, 0.42]
#STL_DIR=renders/stl
#IMG_DIR=renders/img

# Acabamento das arestas no STL (minkowski > 0 é bem mais lento)
#BORDER_RADIUS=0
#BORDER_STYLE=round

# ------------------------------------------------------------
# Animação
# ------------------------------------------------------------
#ANIM_FRAMES=36
#ANIM_DELAY=15
#ASM_ANIM_FRAMES=72
#ASM_ANIM_DELAY=5
#ASM_ANIM_EXPLODE=12
#ASM_ANIM_SPIN=0
#ASM_ANIM_SPEED=1
#ASM_VIDEO_FPS=30
